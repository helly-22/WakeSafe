# Copy to .env.local to override. Never commit real secrets; Vite exposes VITE_* values to the browser.

# true (default): use typed synthetic fixtures in src/services/mock. false: call the backend API.
VITE_USE_MOCKS=true

# Backend origin used when VITE_USE_MOCKS=false, e.g. http://127.0.0.1:8000 (route names pending, TEAM_CONTRACTS.md §9).
VITE_API_BASE_URL=

# Supabase (planned, not connected yet; see supabase/README.md). Placeholders only.
# The anon key is public by design and protected by Row Level Security.
# NEVER put the service-role key here or anywhere in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
